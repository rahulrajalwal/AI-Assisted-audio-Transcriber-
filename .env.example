# Copy this file to .env and fill in your own values. Never commit .env.

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
# Default: OpenAI GPT-4o mini (paid, ~$0.15 per 1M input tokens; needs OpenRouter credits)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional free alternatives (select manually; rate-limited, 50 requests/day):
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Whisper (English, runs locally): tiny | base | small | medium | large
WHISPER_MODEL=small

# Sarvam AI (Hindi / Hinglish)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2.5
