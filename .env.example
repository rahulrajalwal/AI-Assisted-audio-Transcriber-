# Copy this file to .env and fill in your own values. Never commit .env.

# ── Google Gemini (summaries, extraction, RAG answers) ──────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Optional: low | medium | high  (gemini-3.8-flash default is medium; "minimal" is not supported)
# GEMINI_THINKING_LEVEL=
# Optional reliability settings
# GEMINI_MAX_ATTEMPTS=5
# GEMINI_TIMEOUT_SECONDS=180
# GEMINI_MAX_OUTPUT_TOKENS=16384
# GEMINI_MIN_REQUEST_INTERVAL=0      # seconds between requests (e.g. 6 for a 10 RPM limit)

# ── Whisper (English, runs locally) ─────────────────────────────────────────────
WHISPER_MODEL=small

# ── Sarvam AI (Hinglish) ────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2.5

# ── Optional storage locations (relative paths are inside the project folder) ──
# CHROMA_DIR=vector_db
# MEETINGS_DIR=data/meetings
# WORK_DIR=downloads
